                                 session.processingStatus.value = retryStatus(event.attempt)
                             }
 
+                            is AgentEvent.PreviewReset -> {
+                                session.update { latest ->
+                                    event.authoritative?.let { latest.upsertMessage(replyNodeId, it) }
+                                        ?: latest.deleteMessage(event.replyId) ?: latest
