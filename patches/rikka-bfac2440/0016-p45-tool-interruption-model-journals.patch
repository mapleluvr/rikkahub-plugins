     }
 
diff --git a/ai/src/main/java/me/rerere/ai/agent/Retry.kt b/ai/src/main/java/me/rerere/ai/agent/Retry.kt
index 23e57fbde5b8641e09e8d05541edd328cc7960c1..849cca5dcb426685656ed1a90baac28a3dcf9403 100644
--- a/ai/src/main/java/me/rerere/ai/agent/Retry.kt
+++ b/ai/src/main/java/me/rerere/ai/agent/Retry.kt
@@ -34,6 +34,27 @@ data class RetryAttempt(
     val delay: Duration,
 )
 
+/** Retry Provider failures only; host admission/receipt storage failures are not network retries. */
+suspend fun <T> withModelRequestRetry(
+    policy: RetryPolicy,
+    dispatch: suspend (suspend () -> T) -> T,
+    onRetry: suspend (RetryAttempt) -> Unit = {},
+    request: suspend () -> T,
+): T {
+    var providerFailure: Throwable? = null
+    return withRetry(policy.copy(retryOn = { it === providerFailure && policy.retryOn(it) }), onRetry) {
+        providerFailure = null
+        dispatch {
+            try {
+                request()
+            } catch (error: Throwable) {
+                providerFailure = error
+                throw error
+            }
+        }
+    }
+}
+
 /**
  * 按 [policy] 执行 [block]：失败且允许重试时先调用 [onRetry]，等待后再执行一次。
  */
