@@ -85,6 +85,13 @@ interface AgentControl {
     /** Recheck after the durable start marker, immediately before invoking a tool. */
     fun admitTool(message: UIMessage, tool: UIMessagePart.Tool): String? = null
 
+    /**
+     * Classify an interrupted effect before it becomes a confirmed tool-error result.
+     * A non-null reason yields at this tool without output/finishedAt; the host persists any required wait.
+     * Null retains the ordinary domain-error result behavior.
+     */
+    suspend fun toolFailure(message: UIMessage, tool: UIMessagePart.Tool, error: Throwable): String? = null
+
     /** Trusted synchronous admission, repeated immediately before every Provider attempt. */
     fun admitModel(step: Int, attempt: Int): String? = null
 
