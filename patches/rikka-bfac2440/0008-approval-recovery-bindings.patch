             // 只给真正运行的工具计时；开始时先写一次，界面才能在执行中实时显示耗时
             val runs = tool.approvalState == ToolApprovalState.Auto || tool.approvalState == ToolApprovalState.Approved
             if (runs) {
+                findTool(tool.toolName)?.validateExecution?.invoke()?.let {
+                    throw AgentYield(cursor(AgentBoundary.BeforeTool, tool.toolCallId), it)
+                }
                 updateTool(
                     tool.toolCallId,
                     starting = true
                 ) { it.copy(startedAt = Clock.System.now(), finishedAt = null) }
                 kotlinx.coroutines.currentCoroutineContext().ensureActive()
-                request.control.admitTool(checkNotNull(message), tool)?.let {
+                val resourceFailure = findTool(tool.toolName)?.validateExecution?.invoke()
+                (resourceFailure ?: request.control.admitTool(checkNotNull(message), tool))?.let {
                     throw AgentYield(cursor(AgentBoundary.BeforeTool, tool.toolCallId), it)
                 }
             }
