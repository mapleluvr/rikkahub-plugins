+/** Reject ambiguous public names before model preparation, approval, or effect lookup. */
+fun List<Tool>.uniqueToolRegistrations(): Map<String, Tool> = buildMap {
+    for (tool in this@uniqueToolRegistrations) {
+        val previous = put(tool.name, tool)
+        require(previous == null) {
+            "Duplicate tool registration '${tool.name}': ${previous?.executionVersion} and ${tool.executionVersion}"
+        }
+    }
+}
