+    /** Resume the persisted intent without selecting or truncating any page history. Gates still apply. */
+    fun resumePluginRun(conversationId: Uuid) {
+        val session = sessionManager.getOrCreate(conversationId)
+        synchronized(session) {
+            val previous = session.getJob()
+            val job = launchGenerationJob(conversationId = conversationId) {
+                try {
+                    previous?.join()
+                    ensureInitialized(session)
+                    if (session.state.value.hasUnfinishedPluginRun()) runTurn(session)
+                } catch (error: Exception) {
+                    reportFailure(session, error, R.string.error_title_regenerate_message)
+                }
+            }
+            session.setJob(job, cancelPrevious = false)
+        }
+    }
