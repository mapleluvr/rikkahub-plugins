From 902ae9c2512376778666b4b76908f201e27b806b Mon Sep 17 00:00:00 2001
From: Host assembly <host-assembly@example.invalid>
Date: Tue, 17 Nov 2026 02:36:18 +0800
Subject: [PATCH] Make Firebase integration optional for independently built
 hosts

Patch-Id: optional-firebase
---
 app/build.gradle.kts                                 | 11 +++++++++--
 app/src/main/java/me/rerere/rikkahub/di/AppModule.kt | 10 ++++------
 .../java/me/rerere/rikkahub/di/ViewModelModule.kt    |  2 +-
 .../java/me/rerere/rikkahub/ui/pages/chat/ChatVM.kt  | 12 ++++++------
 4 files changed, 20 insertions(+), 15 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 0dbc6da59552b31bfd33f070e7637ab29ac26480..df4083126b6f88aab839dee4178292c65b95925d 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -9,11 +9,17 @@ plugins {
     alias(libs.plugins.kotlin.compose)
     alias(libs.plugins.kotlin.serialization)
     alias(libs.plugins.ksp)
-    alias(libs.plugins.google.services)
-    alias(libs.plugins.firebase.crashlytics)
+    alias(libs.plugins.google.services) apply false
+    alias(libs.plugins.firebase.crashlytics) apply false
     alias(libs.plugins.baselineprofile)
 }
 
+val firebaseEnabled = providers.gradleProperty("pluginHost.firebase.enabled").orNull?.toBooleanStrict() ?: false
+if (firebaseEnabled) {
+    apply(plugin = "com.google.gms.google-services")
+    apply(plugin = "com.google.firebase.crashlytics")
+}
+
 android {
     namespace = "me.rerere.rikkahub"
     compileSdk {
@@ -28,6 +34,7 @@ android {
         targetSdk = 37
         versionCode = 197
         versionName = "3.3.0"
+        buildConfigField("boolean", "FIREBASE_ENABLED", firebaseEnabled.toString())
 
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
 
diff --git a/app/src/main/java/me/rerere/rikkahub/di/AppModule.kt b/app/src/main/java/me/rerere/rikkahub/di/AppModule.kt
index 34394f85d7e226d59ebd23a696e0c0326275f750..5b3fb9fc92ba2cb2ed8b0fffd9b8e75c66b22317 100644
--- a/app/src/main/java/me/rerere/rikkahub/di/AppModule.kt
+++ b/app/src/main/java/me/rerere/rikkahub/di/AppModule.kt
@@ -5,6 +5,7 @@ import com.google.firebase.analytics.analytics
 import com.google.firebase.crashlytics.crashlytics
 import kotlinx.serialization.json.Json
 import me.rerere.rikkahub.AppScope
+import me.rerere.rikkahub.BuildConfig
 import me.rerere.rikkahub.data.ai.ChatRequestFactory
 import me.rerere.rikkahub.data.ai.tools.ChatToolFactory
 import me.rerere.rikkahub.data.ai.tools.local.LocalTools
@@ -60,12 +61,9 @@ val appModule = module {
         TTSManager(get())
     }
 
-    single {
-        Firebase.crashlytics
-    }
-
-    single {
-        Firebase.analytics
+    if (BuildConfig.FIREBASE_ENABLED) {
+        single { Firebase.crashlytics }
+        single { Firebase.analytics }
     }
 
     single {
diff --git a/app/src/main/java/me/rerere/rikkahub/di/ViewModelModule.kt b/app/src/main/java/me/rerere/rikkahub/di/ViewModelModule.kt
index e47d1367e7e85ac6b2bf5f2c394d28afbda7b00d..b68cbdda79d9308b7842c5c69f73fd306b7cda1f 100644
--- a/app/src/main/java/me/rerere/rikkahub/di/ViewModelModule.kt
+++ b/app/src/main/java/me/rerere/rikkahub/di/ViewModelModule.kt
@@ -36,7 +36,7 @@ val viewModelModule = module {
             settingsStore = get(),
             chatService = get(),
             updateChecker = get(),
-            analytics = get(),
+            analytics = getOrNull(),
             filesManager = get(),
             favoriteRepository = get(),
             backgroundShellManager = get(),
diff --git a/app/src/main/java/me/rerere/rikkahub/ui/pages/chat/ChatVM.kt b/app/src/main/java/me/rerere/rikkahub/ui/pages/chat/ChatVM.kt
index 5cc6507c88faf074421fddf47109051234308399..153eb06302023b12605aeed7d80d027dd9c9ec73 100644
--- a/app/src/main/java/me/rerere/rikkahub/ui/pages/chat/ChatVM.kt
+++ b/app/src/main/java/me/rerere/rikkahub/ui/pages/chat/ChatVM.kt
@@ -62,7 +62,7 @@ class ChatVM(
     private val settingsStore: SettingsStore,
     private val chatService: ChatService,
     val updateChecker: UpdateChecker,
-    private val analytics: FirebaseAnalytics,
+    private val analytics: FirebaseAnalytics?,
     private val filesManager: FilesManager,
     private val favoriteRepository: FavoriteRepository,
     private val backgroundShellManager: BackgroundShellManager,
@@ -245,14 +245,14 @@ class ChatVM(
      */
     fun handleMessageSend(content: List<UIMessagePart>,answer: Boolean = true) {
         if (content.isEmptyInputMessage()) return
-        analytics.logEvent("ai_send_message", null)
+        analytics?.logEvent("ai_send_message", null)
 
         chatService.sendMessage(_conversationId, content, answer)
     }
 
     fun handleMessageEdit(parts: List<UIMessagePart>, messageId: Uuid) {
         if (parts.isEmptyInputMessage()) return
-        analytics.logEvent("ai_edit_message", null)
+        analytics?.logEvent("ai_edit_message", null)
 
         viewModelScope.launch {
             chatService.editMessage(_conversationId, messageId, parts)
@@ -286,7 +286,7 @@ class ChatVM(
     }
 
     fun regenerateAtMessage(message: UIMessage) {
-        analytics.logEvent("ai_regenerate_at_message", null)
+        analytics?.logEvent("ai_regenerate_at_message", null)
         chatService.regenerateAtMessage(_conversationId, message.id)
     }
 
@@ -295,7 +295,7 @@ class ChatVM(
         approved: Boolean,
         reason: String = ""
     ) {
-        analytics.logEvent("ai_tool_approval", null)
+        analytics?.logEvent("ai_tool_approval", null)
         chatService.handleToolApproval(_conversationId, toolCallId, approved, reason)
     }
 
@@ -303,7 +303,7 @@ class ChatVM(
         toolCallId: String,
         answer: String,
     ) {
-        analytics.logEvent("ai_tool_answer", null)
+        analytics?.logEvent("ai_tool_answer", null)
         chatService.handleToolApproval(_conversationId, toolCallId, approved = true, answer = answer)
     }
 
