+    private suspend fun admitModel(attempt: Int) {
+        val denied = request.control.prepareModel(logicalSteps, attempt) ?: request.control.admitModel(logicalSteps, attempt)
+        kotlinx.coroutines.currentCoroutineContext().ensureActive()
