-    private val staging = HostApkStaging(File(context.cacheDir, "host-updates"))
+    private val staging = hostApkStaging(context)
     private val refresh = MutableStateFlow(0L)
     private val download = MutableStateFlow<HostUpdateDownload>(HostUpdateDownload.Idle)
     internal val downloadState = download.asStateFlow()
 
-    private var prepared: File? = null
-    private var handedToInstaller = false
+    private var prepared: HostPreparedApk? = null
+    private var activeInstall: HostInstallTicket? = null
     private var downloading: Job? = null
 
