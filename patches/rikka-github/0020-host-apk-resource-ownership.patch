@@ -67,20 +89,23 @@ class UpdateChecker(
     @MainThread
     internal fun download(candidate: HostUpdateCandidate) {
         if (!enabled || downloading?.isCompleted == false || updateState.value != UiState.Success(candidate)) return
-        discardPrepared()
         download.value = HostUpdateDownload.Downloading
         downloading = appScope.launch {
             try {
