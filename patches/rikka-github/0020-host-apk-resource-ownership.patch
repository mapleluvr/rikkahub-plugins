                 )
+                currentCoroutineContext().ensureActive()
                 download.value = HostUpdateDownload.Ready(candidate)
             } catch (cancelled: CancellationException) {
+                discardPrepared()
                 download.value = HostUpdateDownload.Idle
                 throw cancelled
             } catch (error: Exception) {
@@ -94,26 +119,65 @@ class UpdateChecker(
         downloading?.cancel()
     }
 
-    /** Called from the foreground. The system Activity owns the installation confirmation. */
+    /** Foreground installation transfers an exact durable request to an internal Activity. */
     @MainThread
     internal fun install(candidate: HostUpdateCandidate, launch: (Intent) -> Unit) {
-        if (!enabled || download.value != HostUpdateDownload.Ready(candidate)) return
-        try {
-            val apk = requireNotNull(prepared)
-            check(apk.isFile && verifier.installedCode() < candidate.versionCode) { "This update is no longer available" }
-            launch(installIntent(context, apk))
-            // The installer can open this grant after startActivity returns.
-            handedToInstaller = true
-        } catch (error: Exception) {
-            discardPrepared()
-            download.value = HostUpdateDownload.Failed(error.message)
+        if (!enabled || downloading?.isCompleted == false || download.value != HostUpdateDownload.Ready(candidate)) return
+        val apk = prepared ?: return
+        download.value = HostUpdateDownload.Installing(candidate)
+        downloading = appScope.launch {
+            var ticket: HostInstallTicket? = null
+            var enteredBridgeLaunch = false
+            try {
+                check(apk.file.isFile && verifier.installedCode() < candidate.versionCode) { "This update is no longer available" }
+                val request = staging.reserveInstall(apk)
+                ticket = request
+                activeInstall = request
+                currentCoroutineContext().ensureActive()
+                enteredBridgeLaunch = true
+                launch(HostInstallActivity.intent(context, request))
+                discardPrepared()
+            } catch (error: Throwable) {
+                if (!enteredBridgeLaunch || error is ActivityNotFoundException || error is SecurityException) {
+                    ticket?.let { request ->
+                        try {
+                            withContext(NonCancellable) { staging.refuseUnsentInstall(request) }
+                        } catch (cleanup: Throwable) {
+                            error.addSuppressed(cleanup)
+                        }
+                    }
+                }
+                if (error is CancellationException) {
+                    discardPrepared()
+                    if (!enteredBridgeLaunch) download.value = HostUpdateDownload.Idle
+                    throw error
+                }
+                download.value = HostUpdateDownload.Failed(error.message)
+            }
+        }
+    }
+
+    @MainThread
+    internal fun refreshInstallation() {
+        val request = activeInstall ?: return
+        appScope.launch {
+            try {
+                if (!staging.hasInstall(request) && activeInstall == request) {
+                    activeInstall = null
+                    if (download.value is HostUpdateDownload.Installing) download.value = HostUpdateDownload.Idle
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (error: Exception) {
+                if (activeInstall == request) download.value = HostUpdateDownload.Failed(error.message)
+            }
         }
     }
 
-    private fun discardPrepared() {
-        if (!handedToInstaller) prepared?.delete()
-        prepared = null
-        handedToInstaller = false
+    private suspend fun discardPrepared() {
+        val current = prepared ?: return
+        withContext(NonCancellable) { staging.discard(current) }
+        if (prepared === current) prepared = null
     }
 
     private fun resolver() = HostReleaseResolver(
