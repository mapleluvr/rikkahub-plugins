@@ -61,6 +62,18 @@ interface AgentControl {
     /** Persist authoritative state before tool effects or subsequent requests. Never receives stream previews. */
     suspend fun commit(message: UIMessage) {}
 
+    /** Persist output and its next position together; a rejection leaves the output uncommitted and yields. */
+    suspend fun checkpoint(message: UIMessage, cursor: AgentCursor): String? {
+        commit(message)
+        return null
+    }
+
+    /** A persisted unknown effect must wait before executable-cursor validation. */
+    fun resumeBlock(): String? = null
+
+    /** Recheck after the durable start marker, immediately before invoking a tool. */
+    fun admitTool(message: UIMessage, tool: UIMessagePart.Tool): String? = null
+
     /** Trusted synchronous admission, repeated immediately before every Provider attempt. */
     fun admitModel(step: Int, attempt: Int): String? = null
 
